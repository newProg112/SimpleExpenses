<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="12dp"
    android:layout_margin="8dp">

    <!-- Title -->
    <TextView
        android:id="@+id/widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Simple Expenses"
        android:textStyle="bold"
        android:textSize="16sp"
        android:ellipsize="end"
        android:maxLines="1" />

    <!-- Helper / hint text -->
    <TextView
        android:id="@+id/widget_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Tap + for a receipt, car for mileage"
        android:textSize="12sp"
        android:ellipsize="end"
        android:maxLines="1" />

    <!-- Today’s date -->
    <TextView
        android:id="@+id/widget_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Today"
        android:textSize="12sp"
        android:textColor="#888888" />

    <!-- Stats line (filled from code) -->
    <TextView
        android:id="@+id/widget_stats"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="This month: --"
        android:textSize="12sp"
        android:ellipsize="end"
        android:maxLines="1" />

    <!-- Mileage line (filled from code) -->
    <TextView
        android:id="@+id/widget_mileage_stats"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Mileage: --"
        android:textSize="12sp"
        android:ellipsize="end"
        android:maxLines="1" />

    <!-- Buttons row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="end"
        android:orientation="horizontal">

        <!-- Add expense (with camera from widget) -->
        <ImageButton
            android:id="@+id/widget_add_expense"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:selectableItemBackgroundBorderless"
            android:contentDescription="Add expense"
            android:padding="6dp"
            android:src="@android:drawable/ic_menu_camera" />

        <!-- Add mileage -->
        <ImageButton
            android:id="@+id/widget_add_mileage"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:selectableItemBackgroundBorderless"
            android:contentDescription="Add mileage"
            android:padding="6dp"
            android:src="@android:drawable/ic_menu_compass" />

    </LinearLayout>

</LinearLayout>