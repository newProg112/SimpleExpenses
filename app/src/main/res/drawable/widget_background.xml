<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Soft white with a bit of transparency -->
    <solid android:color="#CCFFFFFF" />

    <!-- Rounded corners -->
    <corners android:radius="12dp" />

    <!-- Light outline so it’s visible on light wallpapers too -->
    <stroke
        android:width="1dp"
        android:color="#22000000" />

    <!-- A bit of padding inside the card -->
    <padding
        android:left="4dp"
        android:top="4dp"
        android:right="4dp"
        android:bottom="4dp" />

</shape>